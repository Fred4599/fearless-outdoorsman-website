---
import Layout from "../layouts/Layout.astro";
import InteriorChrome from "../components/InteriorChrome.astro";
import PageHero from "../components/PageHero.astro";
import PageIntro from "../components/PageIntro.astro";
import "../styles/global.css";
import { pageHeroImages } from "../data/site-images";
import { contactEmail, donateUrl } from "../data/site";
import { formatEventDate, golfFundraiserDateIso } from "../data/events";
import { buildBreadcrumbSchema, defaultOgImage, siteUrl } from "../data/seo";

const pageTitle = "Thank You — 2026 Golf Tournament & Fundraiser | Fearless Outdoorsman";
const pageDescription =
  "Thank you to everyone who joined Fearless Outdoorsman's annual golf tournament and fundraiser on June 6, 2026 at Eagle Hills Golf Course in Eagle, Idaho. Your support funds no-cost hunting and fishing trips for children with life-threatening illnesses and veterans with trauma.";

const golfEventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "@id": `${siteUrl}/golf-tournament#event`,
  name: "Fearless Outdoorsman Annual Golf Tournament & Fundraiser",
  description:
    "Annual golf tournament, live auction, dinner, and Rifle Raffle at Eagle Hills Golf Course in Eagle, Idaho — supporting Fearless Outdoorsman's mission of no-cost hunting and fishing trips for children with life-threatening illnesses and veterans with trauma.",
  startDate: golfFundraiserDateIso,
  endDate: golfFundraiserDateIso,
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  isAccessibleForFree: false,
  location: {
    "@type": "Place",
    name: "Eagle Hills Golf Course",
    address: {
      "@type": "PostalAddress",
      streetAddress: "605 N Edgewood Ln",
      addressLocality: "Eagle",
      addressRegion: "ID",
      postalCode: "83616",
      addressCountry: "US",
    },
  },
  organizer: { "@id": `${siteUrl}/#organization` },
  image: [`${siteUrl}${pageHeroImages.golfTournament}`, defaultOgImage],
  url: `${siteUrl}/golf-tournament`,
  performer: { "@id": `${siteUrl}/#organization` },
  audience: {
    "@type": "Audience",
    audienceType: "Public — golfers, supporters, donors, sponsors, and community members",
  },
  about: { "@id": `${siteUrl}/#organization` },
  keywords:
    "golf tournament fundraiser Eagle Idaho, Eagle Hills Golf Course charity event, hunting nonprofit fundraiser, veterans nonprofit fundraiser",
};

const breadcrumbs = buildBreadcrumbSchema([
  { name: "Home", item: "/" },
  { name: "Events", item: "/events" },
  { name: "2026 golf fundraiser", item: "/golf-tournament" },
]);

const eventDayLabel = formatEventDate(golfFundraiserDateIso);
const titleSponsors = [
  { name: "Hubble Homes", src: "/images/sponsors/main-sponsors/hubble-homes.webp" },
  { name: "Camo Cares", src: "/images/sponsors/main-sponsors/camo-cares.webp" },
];
const supportingSponsors = [
  { name: "208 Sacs (Spray)", src: "/images/sponsors/big/208-sacs.webp" },
  { name: "Abilities", src: "/images/sponsors/big/abilities.webp" },
  { name: "Alterra", src: "/images/sponsors/regular/alterra.webp" },
  { name: "American Steel", src: "/images/sponsors/regular/american-steel.webp" },
  { name: "Belgard", src: "/images/sponsors/regular/belgard.webp" },
  { name: "Big Sky Construction", src: "/images/sponsors/regular/big-sky-construction.webp" },
  { name: "Borderline River", src: "/images/sponsors/regular/borderline-river.webp" },
  { name: "Distinctive Millwork", src: "/images/sponsors/regular/distinctive-millwork.webp" },
  { name: "Ditch Witch", src: "/images/sponsors/regular/ditch-witch.webp" },
  { name: "DMS", src: "/images/sponsors/major/dms.webp" },
  { name: "Elson Electric", src: "/images/sponsors/big/elson-electric.webp" },
  { name: "Ford's Fab", src: "/images/sponsors/regular/fords-fab.webp" },
  { name: "H and H", src: "/images/sponsors/huge/h-and-h.webp" },
  { name: "Hawkeye", src: "/images/sponsors/big/hawkeye.webp" },
  { name: "Higgins and Rutledge", src: "/images/sponsors/regular/higgins-and-rutledge.webp" },
  { name: "Hunter's Choice", src: "/images/sponsors/regular/hunters-choice.webp" },
  { name: "Inline Asphalt", src: "/images/sponsors/regular/inline-asphalt.webp" },
  { name: "Kiewit", src: "/images/sponsors/regular/kiewit.webp" },
  { name: "Lafever", src: "/images/sponsors/regular/lafever.webp" },
  { name: "Mark Guho", src: "/images/sponsors/big/mark-guho.webp" },
  { name: "New Life Landscape", src: "/images/sponsors/regular/new-life-landscape.webp" },
  { name: "NW Hardscape", src: "/images/sponsors/big/nw-hardscape.webp" },
  { name: "Premier Aggregates", src: "/images/sponsors/regular/premier-aggregates.webp" },
  { name: "Rifle Guru", src: "/images/sponsors/regular/rifle-guru.webp" },
  { name: "Rosendin Electric", src: "/images/sponsors/regular/rosendin-electric.webp" },
  { name: "Scheels", src: "/images/sponsors/regular/scheels.webp" },
  { name: "Site One", src: "/images/sponsors/medium/site-one.webp" },
  { name: "Sitecrete", src: "/images/sponsors/regular/sitecrete.webp" },
  { name: "Skyline Excavation", src: "/images/sponsors/big/skyline-excavation.webp" },
  { name: "Slattery", src: "/images/sponsors/regular/slattery.webp" },
  { name: "Stor-it", src: "/images/sponsors/major/stor-it_hole-1.webp" },
  { name: "Sunshine", src: "/images/sponsors/regular/sunshine.webp" },
  { name: "TVR", src: "/images/sponsors/big/tvr.webp" },
  { name: "Watertight Mechanical", src: "/images/sponsors/medium/watertight-mechanical.webp" },
];
const tournamentTextSponsors = ["B and B Framing", "Tanner Construction"];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  socialImagePath={pageHeroImages.golfTournament}
  keywords={[
    "Fearless Outdoorsman golf tournament",
    "Eagle Hills Golf Course fundraiser",
    "hunting nonprofit golf event Idaho",
    "veterans nonprofit benefit golf",
  ]}
  schema={[golfEventSchema, breadcrumbs]}
>
  <InteriorChrome>
    <PageHero
      src={pageHeroImages.golfTournament}
      alt="Outdoor community gathering — Fearless Outdoorsman annual golf fundraiser"
    />
    <main class="mx-auto max-w-7xl px-6 pb-32 pt-10 md:pt-14">
      <nav class="text-sm text-zinc-500" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a href="/events" class="font-medium text-accent transition hover:text-primary">Events</a>
          </li>
          <li aria-hidden="true" class="text-zinc-300">/</li>
          <li class="font-medium text-zinc-700">2026 golf fundraiser</li>
        </ol>
      </nav>

      <div class="mt-8 max-w-3xl">
        <PageIntro label="Thank you" />
        <p class="text-sm font-semibold uppercase tracking-widest text-accent">{eventDayLabel}</p>
        <h1 class="mt-3 font-heading text-4xl font-semibold tracking-tighter text-primary md:text-5xl lg:text-6xl">
          What a day at Eagle Hills
        </h1>
        <p class="mt-6 text-base leading-relaxed text-zinc-600">
          Our annual golf tournament and fundraiser is wrapped for 2026 — and it was an incredible one. Golfers,
          dinner guests, raffle supporters, auction bidders, volunteers, and sponsors showed up in force at Eagle Hills
          Golf Course. Every round played, every bid, and every ticket purchased goes straight toward no-cost outdoor
          trips for kids and veterans.
        </p>
        <p class="mt-4 text-base leading-relaxed text-zinc-600">
          If you were there: thank you. Days like this are why Fearless Outdoorsman can keep sending families and
          veterans into the field without asking them to cover the cost.
        </p>
      </div>

      <div
        class="mt-10 grid max-w-3xl gap-6 rounded-2xl border border-zinc-200/80 bg-white/90 p-6 shadow-sm sm:grid-cols-2 sm:p-8"
        role="region"
        aria-label="When and where"
      >
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-zinc-500">When</p>
          <p class="mt-2 font-heading text-lg font-semibold text-zinc-900">{eventDayLabel}</p>
          <p class="mt-1 text-sm text-zinc-600">Golf, auction, dinner, and raffle — one unforgettable day.</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-zinc-500">Where</p>
          <p class="mt-2 font-heading text-lg font-semibold text-zinc-900">Eagle Hills Golf Course</p>
          <p class="mt-1 text-sm leading-relaxed text-zinc-600">605 N Edgewood Ln, Eagle, ID 83616</p>
        </div>
      </div>

      <section class="mt-14" aria-labelledby="highlights-heading">
        <h2 id="highlights-heading" class="font-heading text-2xl font-semibold tracking-tight text-zinc-900 md:text-3xl">
          Highlights from the day
        </h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-3">
          <div class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-widest text-accent">Daytime</p>
            <h3 class="mt-3 font-heading text-lg font-semibold text-zinc-900">Golf tournament</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-600">
              Supporters packed the course — a centerpiece of our biggest fundraising day of the year.
            </p>
          </div>
          <div class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-widest text-accent">Evening</p>
            <h3 class="mt-3 font-heading text-lg font-semibold text-zinc-900">Live auction</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-600">
              Bids on items and experiences that turn directly into outdoor healing trips.
            </p>
          </div>
          <div class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-widest text-accent">Together</p>
            <h3 class="mt-3 font-heading text-lg font-semibold text-zinc-900">Dinner &amp; community</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-600">
              A shared meal, stories from the field, and a room full of people who believe in this mission.
            </p>
          </div>
        </div>
      </section>

      <section
        class="mt-14 rounded-2xl border border-zinc-200/80 bg-white p-8 shadow-sm md:p-10"
        aria-labelledby="sponsors-heading"
      >
        <h2 id="sponsors-heading" class="font-heading text-xl font-semibold tracking-tight text-zinc-900 md:text-2xl">
          Thank you to this year&apos;s sponsors
        </h2>
        <p class="mt-3 max-w-3xl text-base leading-relaxed text-zinc-600">
          This event was possible because of generous businesses and community partners who step up for kids, families,
          and veterans through Fearless Outdoorsman.
        </p>
        <div class="mt-10">
          <p class="text-xs font-semibold uppercase tracking-widest text-accent">Title sponsors</p>
          <div class="mt-4 grid gap-5 sm:grid-cols-2">
            {titleSponsors.map((sponsor) => (
              <article class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-sm ring-1 ring-primary/5">
                <div
                  class="flex h-44 items-center justify-center overflow-hidden rounded-xl p-4"
                  style={`background-color: ${sponsor.name === "Big Sky Construction" ? "#000000" : "#ffffff"};`}
                >
                  <img
                    src={sponsor.src}
                    alt={`${sponsor.name} logo`}
                    loading="lazy"
                    decoding="async"
                    class="max-h-full max-w-full object-contain"
                  />
                </div>
                <p class="mt-4 text-center font-heading text-base font-semibold text-zinc-900">{sponsor.name}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="mt-12">
          <div class="flex items-baseline justify-between gap-4">
            <p class="text-xs font-semibold uppercase tracking-widest text-accent">Supporting sponsors</p>
            <p class="text-xs text-zinc-400">{supportingSponsors.length} partners</p>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
            {supportingSponsors.map((sponsor) => (
              <div
                class="flex h-20 items-center justify-center overflow-hidden rounded-lg border border-zinc-200/80 p-2 sm:h-24 sm:p-3"
                style={`background-color: ${sponsor.name === "Big Sky Construction" ? "#000000" : "#ffffff"};`}
                title={sponsor.name}
              >
                <img
                  src={sponsor.src}
                  alt={`${sponsor.name} logo`}
                  loading="lazy"
                  decoding="async"
                  class="max-h-full max-w-full object-contain"
                />
              </div>
            ))}
          </div>
          <p class="mt-5 text-sm leading-relaxed text-zinc-500">
            <span class="font-medium text-zinc-700">Also supporting:</span> {tournamentTextSponsors.join(", ")}.
          </p>
        </div>
      </section>

      <section
        class="mt-14 rounded-2xl border border-zinc-200/80 bg-gradient-to-br from-primary/[0.06] to-white p-8 md:p-10"
        aria-labelledby="support-heading"
      >
        <h2 id="support-heading" class="font-heading text-xl font-semibold tracking-tight text-zinc-900 md:text-2xl">
          Keep the momentum going
        </h2>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-zinc-600">
          Ticket sales are closed for this year&apos;s tournament, but the mission continues year-round. A gift today
          still funds gear, travel, and guided days for kids and veterans — and we&apos;d love to have you back when we
          announce next year&apos;s date.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={donateUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex rounded-full bg-primary px-8 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-primary/90"
          >
            Donate
          </a>
          <a
            href="/sponsors"
            class="inline-flex rounded-full border border-zinc-300 bg-white px-8 py-3.5 text-sm font-semibold text-zinc-800 transition hover:border-primary/30 hover:bg-zinc-50"
          >
            See our donors &amp; sponsors
          </a>
          <a
            href={`mailto:${contactEmail}`}
            class="inline-flex rounded-full border border-transparent px-8 py-3.5 text-sm font-semibold text-accent underline-offset-4 hover:text-primary hover:underline"
          >
            Get involved
          </a>
        </div>
        <p class="mt-8 text-sm text-zinc-500">
          <a href="/events" class="font-medium text-accent hover:text-primary">Back to events</a>
          {" "}·{" "}
          <a href="/contactus" class="font-medium text-accent hover:text-primary">Contact</a>
        </p>
      </section>
    </main>
  </InteriorChrome>
</Layout>
